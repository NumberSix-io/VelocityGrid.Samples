<Window
    x:Class="VelocityGrid.Sample.Wpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vg="clr-namespace:VelocityGrid.Wpf;assembly=VelocityGrid.Wpf"
    Title="VelocityGrid — WPF NuGet sample"
    Width="1100"
    Height="700">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Append 1,000" Click="Append_Click" Margin="0,0,8,0"/>
            <Button Content="Invalidate rows 0–127" Click="Invalidate_Click" Margin="0,0,8,0"/>
            <Button Content="Sort / refresh" Click="Refresh_Click" Margin="0,0,8,0"/>
            <Button Content="Jump near end" Click="End_Click"/>
            <TextBlock x:Name="Status" Margin="16,3,0,0"/>
        </StackPanel>
        <vg:VelocityGridHost x:Name="GridHost" Grid.Row="1" RowHeight="25"/>
    </Grid>
</Window>
